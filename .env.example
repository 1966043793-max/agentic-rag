# ===== LLM（OpenAI 兼容接口）=====
# 示例：DeepSeek。任何 OpenAI 兼容服务都可以，改 base_url + model 即可。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-llm-key-here
LLM_MODEL=deepseek-chat
TEMPERATURE=0.0

# ===== Embedding（重要：DeepSeek 不提供 embedding 接口，需单独配一个）=====
# 推荐一：硅基流动 BGE（OpenAI 兼容，便宜/有免费额度）
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-your-embedding-key-here
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# 推荐二：阿里云 DashScope（OpenAI 兼容模式）
#   EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   EMBEDDING_API_KEY=sk-your-dashscope-key
#   EMBEDDING_MODEL=text-embedding-v3
# 推荐三：智谱
#   EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   EMBEDDING_MODEL=embedding-3

# ===== 检索 =====
TOP_K=6
BM25_TOP_K=20
HYBRID_ALPHA=0.5
RERANK=true
RERANK_TOP_N=3

# ===== Agent =====
MAX_ITERATIONS=8

# ===== API 服务 =====
HOST=0.0.0.0
PORT=8000
